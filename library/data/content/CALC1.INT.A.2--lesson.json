    {
      "type": "practice",
      "id": 5,
      "prompt": "If $F(x)=\\int_2^x e^{t}\\,dt$, find $F'(x)$.",
      "solution": {
        "steps": [
          "By Part 1, $F'(x)=e^x$."
        ],
        "answer": "$F'(x)=e^x$"
