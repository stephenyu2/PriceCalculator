    {
      "type": "worked-example",
      "id": 2,
      "prompt": "Write '$3$ times the sum of $4$ and $5$' as an expression.",
      "solution": {
        "steps": [
          "The sum of $4$ and $5$ is $(4 + 5)$.",
          "$3$ times that is $3 \\times (4 + 5)$."
        ],
        "answer": "$3 \\times (4 + 5)$"
      }
    },
    {
      "type": "worked-example",
      "id": 3,
      "prompt": "Without computing, is $3 \\times (200 + 50)$ greater than, less than, or equal to $200 + 50$?",
      "solution": {
        "steps": [
          "$3 \\times (200 + 50)$ is three times the sum.",
          "So it is greater than $200 + 50$ (three times as large)."
        ],
        "answer": "Greater (three times as large)"
      }
