      "type": "worked-example",
      "id": 1,
      "prompt": "A rectangle has $3$ rows of $4$ unit squares. Find the area by counting.",
      "solution": {
        "steps": [
          "Count all the squares: $3$ rows of $4$ is $4 + 4 + 4 = 12$.",
          "So the area is $12$ square units."
        ],
        "answer": "$12$ square units"
      }
    },
    {
      "type": "worked-example",
      "id": 2,
      "prompt": "A rectangle has $2$ rows of $5$ unit squares. What is the area?",
      "solution": {
        "steps": [
          "$5 + 5 = 10$ squares.",
          "Area is $10$ square units."
        ],
        "answer": "$10$ square units"
      }
    },
