      "type": "worked-example",
      "id": 1,
      "prompt": "For $f(x)=x^2+1$, find $f(3)$.",
      "solution": {
        "steps": [
          "Substitute $x=3$: $f(3)=3^2+1$.",
          "Compute: $9+1=10$."
        ],
        "answer": "$f(3)=10$"
      }
    },
    {
      "type": "worked-example",
      "id": 2,
      "prompt": "For $f(x)=2x$ and $g(x)=x+1$, find $f(g(3))$.",
      "solution": {
        "steps": [
          "First $g(3)=3+1=4$.",
          "Then $f(4)=2(4)=8$."
        ],
        "answer": "$f(g(3))=8$"
      }
    },
    {
      "type": "worked-example",
      "id": 3,
      "prompt": "Solve the system $y=x^2$ and $y=x+2$.",
      "solution": {
        "steps": [
          "Set equal: $x^2=x+2$, so $x^2-x-2=0$.",
          "Factor: $(x-2)(x+1)=0$, giving $x=2$ or $x=-1$.",
          "Then $y=4$ or $y=1$, so the points are $(2,4)$ and $(-1,1)$."
        ],
        "answer": "$(2,4)$ and $(-1,1)$"
      }
    },
