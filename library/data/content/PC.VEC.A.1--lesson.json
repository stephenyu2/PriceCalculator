    {
      "type": "practice",
      "id": 9,
      "prompt": "Given $\\vec{u} = \\langle 1, 7 \\rangle$ and $\\vec{v} = \\langle 3, -1 \\rangle$, find $\\lVert \\vec{u} + \\vec{v} \\rVert$.",
      "hint": "Add the vectors first to get the resultant, then apply $\\sqrt{a^2 + b^2}$. Do not add the magnitudes separately.",
