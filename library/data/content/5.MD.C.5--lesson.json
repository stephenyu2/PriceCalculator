      "type": "worked-example",
      "id": 1,
      "prompt": "Find the volume of a box $4$ by $3$ by $2$ using length times width times height.",
      "solution": {
        "steps": [
          "Volume $= l \\times w \\times h = 4 \\times 3 \\times 2$.",
          "$4 \\times 3 = 12$, then $12 \\times 2 = 24$."
        ],
        "answer": "$24$ cubic units"
      }
    },
    {
      "type": "worked-example",
      "id": 2,
      "prompt": "A cube has edges of $3$ units. Find its volume.",
      "solution": {
        "steps": [
          "$3 \\times 3 \\times 3 = 27$."
        ],
        "answer": "$27$ cubic units"
      }
    },
    {
      "type": "worked-example",
      "id": 3,
      "prompt": "Find the volume of a box $5$ by $2$ by $2$.",
      "solution": {
