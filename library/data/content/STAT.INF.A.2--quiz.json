    },
    {
      "type": "multiple-choice",
      "id": 4,
      "difficulty": "Medium",
      "prompt": "95% CI for $\\hat{p}=0.5,n=100$:\nA) $(0.45,0.55)$\nB) $(0.402,0.598)$\nC) $(0.4,0.6)$\nD) $(0.48,0.52)$",
      "answer": "B) $(0.402,0.598)$",
      "solution": {
        "steps": [
          "$0.5\\pm 1.96(0.05)$. Key is B."
        ],
        "answer": "B) $(0.402,0.598)$"
      }
    },
    {
      "type": "multiple-choice",
      "id": 5,
      "difficulty": "Medium",
      "prompt": "Large-counts condition requires:\nA) $n\\ge 30$\nB) $n\\hat{p}\\ge 10$ and $n(1-\\hat{p})\\ge 10$\nC) $\\hat{p}\\ge 0.5$\nD) population normal",
      "answer": "B) $n\\hat{p}\\ge 10$ and $n(1-\\hat{p})\\ge 10$",
