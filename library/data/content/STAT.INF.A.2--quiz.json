      "type": "multiple-choice",
      "id": 1,
      "difficulty": "Easy",
      "prompt": "The SE for a proportion is:\nA) $\\sqrt{\\hat{p}(1-\\hat{p})n}$\nB) $\\sqrt{\\frac{\\hat{p}(1-\\hat{p})}{n}}$\nC) $\\frac{\\hat{p}}{n}$\nD) $\\hat{p}(1-\\hat{p})$",
      "answer": "B) $\\sqrt{\\frac{\\hat{p}(1-\\hat{p})}{n}}$",
      "solution": {
        "steps": [
          "SE formula. Key is B."
        ],
        "answer": "B) $\\sqrt{\\frac{\\hat{p}(1-\\hat{p})}{n}}$"
      }
    },
    {
      "type": "multiple-choice",
      "id": 2,
      "difficulty": "Easy",
      "prompt": "$z^*$ for $95\\%$ confidence is:\nA) $1.645$\nB) $1.96$\nC) $2.576$\nD) $2$",
      "answer": "B) $1.96$",
      "solution": {
        "steps": [
          "Standard value. Key is B."
        ],
        "answer": "B) $1.96$"
      }
    },
    {
      "type": "multiple-choice",
      "id": 3,
      "difficulty": "Medium",
      "prompt": "SE for $\\hat{p}=0.5,n=100$:\nA) $0.5$\nB) $0.05$\nC) $0.025$\nD) $0.25$",
      "answer": "B) $0.05$",
      "solution": {
        "steps": [
          "$\\sqrt{0.25/100}$. Key is B."
