  "intro": "Each problem asks for a single direct operation on vectors given in component form. Add or subtract component by component, multiply each component by the scalar, or use $\\lVert \\langle a, b \\rangle \\rVert = \\sqrt{a^2 + b^2}$ for magnitude.",
  "items": [
    {
      "id": 1,
      "prompt": "Given $\\vec{u} = \\langle 3, 5 \\rangle$ and $\\vec{v} = \\langle 1, 2 \\rangle$, find $\\vec{u} + \\vec{v}$.",
      "answer": "$\\langle 4, 7 \\rangle$",
      "solution": {
        "steps": [
          "Add the corresponding components: $\\langle 3 + 1, 5 + 2 \\rangle$.",
          "$\\langle 4, 7 \\rangle$."
        ]
      }
    },
    {
      "id": 2,
      "prompt": "Given $\\vec{u} = \\langle 6, 1 \\rangle$ and $\\vec{v} = \\langle 2, 4 \\rangle$, find $\\vec{u} - \\vec{v}$.",
