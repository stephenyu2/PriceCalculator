      "type": "worked-example",
      "id": 1,
      "prompt": "A box has $2$ layers, each with $6$ unit cubes. Find the volume by counting.",
      "solution": {
        "steps": [
          "Each layer has $6$ cubes; $2$ layers: $6 + 6 = 12$.",
          "So the volume is $12$ cubic units."
        ],
        "answer": "$12$ cubic units"
      }
    },
    {
      "type": "worked-example",
      "id": 2,
      "prompt": "A box has $3$ layers of $4$ cubes. What is the volume?",
      "solution": {
        "steps": [
          "$4 \\times 3 = 12$ cubes.",
          "Volume is $12$ cubic units."
        ],
        "answer": "$12$ cubic units"
      }
    },
    {
      "type": "worked-example",
      "id": 3,
      "prompt": "A box is $2$ by $3$ by $2$ unit cubes. How many cubes fill it?",
      "solution": {
        "steps": [
          "The bottom layer is $2 \\times 3 = 6$ cubes, and there are $2$ layers.",
          "$6 \\times 2 = 12$ cubes."
        ],
        "answer": "$12$ cubic units"
      }
    },
