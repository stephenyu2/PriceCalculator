        "answer": "$x^4-2x+C$"
      }
    },
    {
      "type": "practice",
      "id": 5,
      "prompt": "Find $\\int (e^x+\\cos x)\\,dx$.",
      "solution": {
        "steps": [
          "$e^x+\\sin x+C$."
        ],
        "answer": "$e^x+\\sin x+C$"
      }
    },
    {
      "type": "practice",
