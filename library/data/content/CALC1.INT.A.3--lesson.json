      "prompt": "Solve $F'(x)=2x$, $F(0)=3$.",
      "solution": {
        "steps": [
          "$F(x)=x^2+C$; $F(0)=3\\Rightarrow C=3$."
        ],
        "answer": "$F(x)=x^2+3$"
