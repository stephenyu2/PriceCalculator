      "prompt": "From data with lengths $\\frac{1}{4}, \\frac{1}{4}, \\frac{3}{4}$, how many are $\\frac{1}{4}$ inch?",
      "solution": {
        "steps": [
          "Count the $\\frac{1}{4}$ values: two.",
          "So $2$ pencils are $\\frac{1}{4}$ inch."
        ],
        "answer": "$2$"
      }
