      "prompt": "A line plot shows pencil lengths. Two are $\\frac{1}{2}$ inch and three are $\\frac{1}{4}$ inch. How many pencils in all?",
      "solution": {
        "steps": [
          "Add the counts: $2 + 3 = 5$."
        ],
        "answer": "$5$ pencils"
      }
