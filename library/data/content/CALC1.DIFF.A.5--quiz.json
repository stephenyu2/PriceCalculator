  "intro": "Use implicit differentiation to find $\\frac{dy}{dx}$ and tangent slopes.",
  "items": [
    {
      "type": "multiple-choice",
      "id": 1,
      "difficulty": "Easy",
      "prompt": "For $x^2+y^2=1$, $\\frac{dy}{dx}=?$\nA) $\\frac{x}{y}$\nB) $-\\frac{x}{y}$\nC) $-\\frac{y}{x}$\nD) $\\frac{y}{x}$",
      "answer": "B) $-\\frac{x}{y}$",
      "solution": {
        "steps": [
          "$2x+2yy'=0\\Rightarrow y'=-\\frac{x}{y}$. Key is B."
        ],
        "answer": "B) $-\\frac{x}{y}$"
      }
    },
    {
      "type": "multiple-choice",
      "id": 2,
      "difficulty": "Easy",
      "prompt": "For $xy=1$, $\\frac{dy}{dx}=?$\nA) $-\\frac{y}{x}$\nB) $\\frac{y}{x}$\nC) $-\\frac{x}{y}$\nD) $1$",
      "answer": "A) $-\\frac{y}{x}$",
      "solution": {
        "steps": [
          "$y+xy'=0\\Rightarrow y'=-\\frac{y}{x}$. Key is A."
        ],
        "answer": "A) $-\\frac{y}{x}$"
      }
    },
    {
      "type": "multiple-choice",
      "id": 3,
      "difficulty": "Medium",
      "prompt": "For $y^2=4x$, the slope at $(1,2)$ is:\nA) $\\frac{1}{2}$\nB) $1$\nC) $2$\nD) $4$",
      "answer": "B) $1$",
      "solution": {
        "steps": [
          "$y'=\\frac{2}{y}=\\frac{2}{2}=1$. Key is B."
        ],
        "answer": "B) $1$"
      }
    },
    {
      "type": "multiple-choice",
      "id": 4,
      "difficulty": "Medium",
      "prompt": "For $x^2+y^2=25$ the tangent is horizontal at:\nA) $(3,4)$\nB) $(5,0)$\nC) $(0,5)$\nD) $(4,3)$",
      "answer": "C) $(0,5)$",
      "solution": {
        "steps": [
          "$y'=-\\frac{x}{y}=0$ needs $x=0$, i.e. $(0,\\pm5)$. Key is C."
        ],
        "answer": "C) $(0,5)$"
      }
    },
    {
      "type": "multiple-choice",
      "id": 5,
      "difficulty": "Medium",
      "prompt": "For $xy+y=4$, $\\frac{dy}{dx}=?$\nA) $-\\frac{y}{x+1}$\nB) $\\frac{y}{x+1}$\nC) $-\\frac{y}{x}$\nD) $-y$",
      "answer": "A) $-\\frac{y}{x+1}$",
      "solution": {
        "steps": [
          "$y+xy'+y'=0\\Rightarrow y'(x+1)=-y$. Key is A."
        ],
        "answer": "A) $-\\frac{y}{x+1}$"
      }
    },
    {
      "type": "multiple-choice",
      "id": 6,
      "difficulty": "Medium",
      "prompt": "For $x^3+y^3=9$, $\\frac{dy}{dx}=?$\nA) $-\\frac{x^2}{y^2}$\nB) $\\frac{x^2}{y^2}$\nC) $-\\frac{x}{y}$\nD) $-\\frac{3x^2}{y^2}$",
      "answer": "A) $-\\frac{x^2}{y^2}$",
      "solution": {
        "steps": [
          "$3x^2+3y^2y'=0\\Rightarrow y'=-\\frac{x^2}{y^2}$. Key is A."
