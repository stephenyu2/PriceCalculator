    {
      "type": "worked-example",
      "id": 3,
      "prompt": "Sam read $6$ books. His sister read $18$. How many times as many did his sister read?",
      "solution": {
        "steps": [
          "$18 \\div 6 = 3$.",
          "So $3$ times as many."
        ],
        "answer": "$3$ times"
      }
