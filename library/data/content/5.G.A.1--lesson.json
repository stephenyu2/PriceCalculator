    },
    {
      "type": "worked-example",
      "id": 2,
      "prompt": "In $(4, 3)$, what does the second number tell you?",
      "solution": {
        "steps": [
          "The second number is the $y$-coordinate.",
          "It tells how far up to move: $3$."
        ],
        "answer": "Move $3$ up (the $y$-coordinate)"
      }
    },
    {
      "type": "worked-example",
      "id": 3,
      "prompt": "Where is the point $(0, 0)$?",
      "solution": {
        "steps": [
