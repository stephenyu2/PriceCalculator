  "intro": "A binomial setting has a fixed number of trials $n$, two outcomes per trial (success/failure), a constant success probability $p$, and independent trials. Then $P(X=k)=\\binom{n}{k}p^k(1-p)^{n-k}$. The mean is $\\mu=np$ and the standard deviation is $\\sigma=\\sqrt{np(1-p)}$. Use the formula for exact counts and sums of formula terms for 'at least' or 'at most' questions (or the complement for efficiency).",
  "items": [
    {
      "type": "worked-example",
      "id": 1,
      "prompt": "$X$ is binomial with $n=5$, $p=0.5$. Find $P(X=2)$.",
      "solution": {
        "steps": [
          "Use $P(X=k)=\\binom{n}{k}p^k(1-p)^{n-k}$ with $k=2$.",
          "$\\binom{5}{2}=10$, and $p^2(1-p)^3=(0.5)^2(0.5)^3=(0.5)^5=\\frac{1}{32}$.",
          "Multiply: $10\\cdot\\frac{1}{32}=\\frac{10}{32}=0.3125$."
        ],
        "answer": "$P(X=2)=0.3125$"
      }
    },
    {
      "type": "worked-example",
      "id": 2,
      "prompt": "For $n=20$, $p=0.3$, find the mean of $X$.",
      "solution": {
        "steps": [
          "Use $\\mu=np$.",
          "$20\\cdot 0.3=6$."
        ],
        "answer": "$\\mu=6$"
      }
    },
    {
      "type": "worked-example",
      "id": 3,
      "prompt": "For $n=100$, $p=0.5$, find the standard deviation of $X$.",
      "solution": {
        "steps": [
          "Use $\\sigma=\\sqrt{np(1-p)}$.",
          "$\\sqrt{100\\cdot 0.5\\cdot 0.5}=\\sqrt{25}=5$."
        ],
        "answer": "$\\sigma=5$"
      }
    },
