      "id": 1,
      "prompt": "Two angles of $30^\\circ$ and $40^\\circ$ are next to each other. What is the total angle?",
      "solution": {
        "steps": [
          "Add the angles: $30 + 40 = 70$.",
          "So the total is $70^\\circ$."
        ],
        "answer": "$70^\\circ$"
      }
    },
    {
      "type": "worked-example",
      "id": 2,
      "prompt": "A $90^\\circ$ angle is split into a $35^\\circ$ angle and another. What is the other angle?",
      "solution": {
        "steps": [
          "Subtract: $90 - 35 = 55$.",
          "So the other angle is $55^\\circ$."
        ],
        "answer": "$55^\\circ$"
      }
    },
    {
      "type": "worked-example",
      "id": 3,
      "prompt": "Angles of $50^\\circ$ and $60^\\circ$ together make what angle?",
      "solution": {
        "steps": [
          "$50 + 60 = 110^\\circ$."
        ],
        "answer": "$110^\\circ$"
      }
    },
    {
