  "intro": "Equivalent expressions have the same value for every input. Core skills: distribute and combine like terms, factor (common factor, difference of squares $a^2-b^2=(a-b)(a+b)$, trinomials), expand products, and simplify fractions by canceling common factors. The SAT rewards recognizing a factored form or a hidden perfect square quickly.",
  "items": [
    {
      "type": "worked-example",
      "id": 1,
      "prompt": "Expand $(x+3)(x-5)$.",
      "solution": {
        "steps": [
          "Use FOIL: $x\\cdot x+x\\cdot(-5)+3\\cdot x+3\\cdot(-5)$.",
          "That is $x^2-5x+3x-15$.",
          "Combine like terms: $x^2-2x-15$."
        ],
        "answer": "$x^2-2x-15$"
      }
    },
    {
      "type": "worked-example",
      "id": 2,
      "prompt": "Factor $x^2-9$.",
      "solution": {
        "steps": [
          "Recognize a difference of squares: $x^2-3^2$.",
          "Apply $a^2-b^2=(a-b)(a+b)$.",
          "So $x^2-9=(x-3)(x+3)$."
        ],
        "answer": "$(x-3)(x+3)$"
      }
    },
    {
      "type": "worked-example",
      "id": 3,
      "prompt": "Simplify $\\dfrac{x^2-4}{x-2}$.",
      "solution": {
        "steps": [
          "Factor the numerator: $x^2-4=(x-2)(x+2)$.",
          "Cancel the common factor $x-2$ (for $x\\ne 2$).",
          "The result is $x+2$."
        ],
        "answer": "$x+2$"
      }
    },
    {
      "type": "practice",
      "id": 4,
      "prompt": "Expand $(x+2)(x+4)$.",
      "solution": {
        "steps": [
          "$x^2+6x+8$."
        ],
        "answer": "$x^2+6x+8$"
      }
    },
    {
      "type": "practice",
      "id": 5,
      "prompt": "Factor $x^2-16$.",
      "solution": {
        "steps": [
          "Difference of squares: $(x-4)(x+4)$."
        ],
        "answer": "$(x-4)(x+4)$"
      }
    },
    {
      "type": "practice",
      "id": 6,
      "prompt": "Factor $x^2+5x+6$.",
