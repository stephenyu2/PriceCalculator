    {
      "id": 6,
      "prompt": "Find the angle $\\theta$ between $\\vec{u}=\\langle 1,\\sqrt{3}\\rangle$ and $\\vec{v}=\\langle \\sqrt{3},1\\rangle$. Give an exact answer in radians.",
      "answer": "$\\theta=\\frac{\\pi}{6}$",
      "solution": {
        "steps": [
