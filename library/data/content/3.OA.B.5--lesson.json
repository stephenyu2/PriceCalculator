    {
      "type": "worked-example",
      "id": 1,
      "prompt": "If $6 \\times 4 = 24$, what is $4 \\times 6$?",
      "solution": {
        "steps": [
          "Order does not change a product (commutative property).",
          "So $4 \\times 6 = 24$ too."
        ],
        "answer": "$24$"
      }
    },
    {
      "type": "worked-example",
      "id": 2,
      "prompt": "Use $(2 \\times 3) \\times 4$. Group differently and find the product.",
      "solution": {
        "steps": [
          "Grouping does not change the product (associative property).",
          "$(2 \\times 3) \\times 4 = 6 \\times 4 = 24$; also $2 \\times (3 \\times 4) = 2 \\times 12 = 24$."
        ],
        "answer": "$24$"
      }
    },
    {
      "type": "worked-example",
      "id": 3,
      "prompt": "Break apart $7 \\times 6$ as $7 \\times 5 + 7 \\times 1$. What is the product?",
      "solution": {
        "steps": [
          "Distribute: $7 \\times 5 = 35$ and $7 \\times 1 = 7$.",
          "$35 + 7 = 42$."
        ],
        "answer": "$42$"
      }
    },
    {
      "type": "practice",
      "id": 4,
      "prompt": "What is $8 \\times 1$?",
      "solution": {
        "steps": [
          "Any number times $1$ is itself.",
          "$8 \\times 1 = 8$."
        ],
        "answer": "$8$"
      }
    },
    {
      "type": "practice",
      "id": 5,
      "prompt": "What is $5 \\times 0$?",
      "solution": {
        "steps": [
          "Any number times $0$ is $0$.",
          "$5 \\times 0 = 0$."
        ],
        "answer": "$0$"
      }
    },
    {
      "type": "practice",
      "id": 6,
      "prompt": "If $3 \\times 8 = 24$, use the commutative property to find $8 \\times 3$.",
      "solution": {
        "steps": [
          "Order does not change the product.",
          "$8 \\times 3 = 24$."
        ],
        "answer": "$24$"
      }
    }
  ]
