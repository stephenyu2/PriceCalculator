  "intro": "Words have meanings we can learn. Sometimes a word is part of a bigger word (play, playing). Kindergartners learn what common words mean and how endings like -ing and -ed change a word.",
  "items": [
    {
      "type": "worked-example",
      "id": 1,
      "prompt": "What does 'happy' mean?",
      "solution": {
        "steps": [
          "'Happy' is how you feel when things are good.",
          "It means glad or feeling good."
        ],
        "answer": "Glad; feeling good."
      }
    },
    {
      "type": "worked-example",
      "id": 2,
      "prompt": "'Play' plus '-ing' makes 'playing.' What does 'playing' mean?",
      "solution": {
        "steps": [
          "The -ing ending shows it is happening now.",
          "So 'playing' means doing the action of play right now."
        ],
        "answer": "Doing play right now."
      }
    },
    {
      "type": "worked-example",
      "id": 3,
      "prompt": "What does 'tiny' mean?",
      "solution": {
        "steps": [
          "'Tiny' describes size.",
          "It means very small."
        ],
        "answer": "Very small."
      }
    },
    {
      "type": "practice",
      "id": 4,
      "prompt": "What does 'big' mean?",
      "solution": {
        "steps": [
          "'Big' means large."
        ],
        "answer": "Large."
      }
    },
    {
      "type": "practice",
      "id": 5,
      "prompt": "'Jump' plus '-ed' makes 'jumped.' When did it happen?",
      "solution": {
        "steps": [
          "-ed shows it already happened (past)."
        ],
        "answer": "In the past."
      }
    },
