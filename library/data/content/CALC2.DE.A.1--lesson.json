      "id": 5,
      "prompt": "Solve $\\dfrac{dy}{dx}=\\dfrac{y}{x}$ for $x>0$, general solution.",
      "solution": {
        "steps": [
          "$\\frac{dy}{y}=\\frac{dx}{x}$; $\\ln|y|=\\ln|x|+C$; $y=Ax$."
        ],
        "answer": "$y=Ax$"
