  "intro": "Volume formulas: cylinder $V=\\pi r^2 h$; cone $V=\\frac{1}{3}\\pi r^2 h$; sphere $V=\\frac{4}{3}\\pi r^3$; rectangular prism $V=lwh$. Substitute the given measurements and simplify. Answers are often left in terms of $\\pi$ for exactness. Keep units consistent; volume is measured in cubic units.",
  "items": [
    {
      "type": "worked-example",
      "id": 1,
      "prompt": "Find the volume of a cylinder with radius $3$ and height $5$, in terms of $\\pi$.",
      "solution": {
        "steps": [
          "Use $V=\\pi r^2 h$.",
          "$=\\pi(3)^2(5)=\\pi(9)(5)$.",
          "$=45\\pi$."
        ],
        "answer": "$45\\pi$."
      }
    },
    {
      "type": "worked-example",
      "id": 2,
      "prompt": "Find the volume of a cone with radius $3$ and height $5$, in terms of $\\pi$.",
      "solution": {
        "steps": [
          "Use $V=\\frac{1}{3}\\pi r^2 h$.",
          "$=\\frac{1}{3}\\pi(9)(5)=\\frac{1}{3}(45\\pi)$.",
          "$=15\\pi$."
        ],
        "answer": "$15\\pi$."
      }
    },
    {
      "type": "worked-example",
      "id": 3,
      "prompt": "Find the volume of a sphere with radius $3$, in terms of $\\pi$.",
      "solution": {
        "steps": [
          "Use $V=\\frac{4}{3}\\pi r^3$.",
          "$=\\frac{4}{3}\\pi(3)^3=\\frac{4}{3}\\pi(27)$.",
          "$=36\\pi$."
        ],
        "answer": "$36\\pi$."
      }
    },
    {
      "type": "practice",
      "id": 4,
      "prompt": "Write the volume formula for a cylinder.",
      "solution": {
        "steps": [
          "Base area times height.",
          "$\\pi r^2 h$."
        ],
        "answer": "$V=\\pi r^2 h$."
      }
    },
    {
      "type": "practice",
