      "prompt": "Find the volume of a rectangular prism $2$ by $3$ by $4$.",
      "solution": {
        "steps": [
          "$V=lwh=2\\cdot 3\\cdot 4$.",
          "$=24$."
        ],
        "answer": "$24$."
