      "id": 1,
      "prompt": "You share $12$ apples equally among $3$ friends. How many does each get?",
      "solution": {
        "steps": [
          "Sharing equally is division: $12 \\div 3$.",
          "$12 \\div 3 = 4$, so each gets $4$."
        ],
        "answer": "$4$ apples"
      }
    },
    {
      "type": "worked-example",
      "id": 2,
      "prompt": "What does $20 \\div 5$ mean?",
      "solution": {
        "steps": [
          "It asks how many groups of $5$ are in $20$, or $20$ shared into $5$ groups.",
          "$20 \\div 5 = 4$."
        ],
        "answer": "$4$"
      }
    },
