      "id": 1,
      "prompt": "Break 'rebuilding' into its prefix, base word, and suffix.",
      "solution": {
        "steps": [
          "The prefix is 're-' (again).",
          "The base word is 'build.'",
          "The suffix is '-ing.'",
          "So it is re + build + ing."
        ],
        "answer": "re + build + ing."
      }
    },
    {
      "type": "worked-example",
      "id": 2,
      "prompt": "How many syllables are in 'information'? (in-for-ma-tion)",
      "solution": {
        "steps": [
          "I clap the parts: in-for-ma-tion.",
          "That is four parts.",
          "So 'information' has four syllables."
        ],
        "answer": "Four."
      }
