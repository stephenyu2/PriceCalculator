      "id": 1,
      "prompt": "On a number line, you start at $3$ and move $5$ to the right. Where do you land?",
      "solution": {
        "steps": [
          "Moving right means adding: $3 + 5$.",
          "$3 + 5 = 8$, so you land on $8$."
        ],
        "answer": "$8$"
      }
    },
    {
      "type": "worked-example",
      "id": 2,
      "prompt": "On a number line, start at $10$ and move $4$ to the left. Where do you land?",
      "solution": {
        "steps": [
          "Moving left means subtracting: $10 - 4$.",
          "$10 - 4 = 6$."
        ],
        "answer": "$6$"
      }
    },
    {
      "type": "worked-example",
      "id": 3,
      "prompt": "A jump from $2$ to $9$ on a number line is how long?",
      "solution": {
        "steps": [
          "The length of a jump is the difference: $9 - 2 = 7$."
        ],
        "answer": "$7$ units"
      }
    },
