  "intro": "Probability is favorable outcomes over total outcomes for equally likely cases, a number from $0$ to $1$. Two-way tables make SAT probability concrete: a simple probability uses the grand total as the denominator, while a conditional probability restricts to one row or column and uses that total. Complement: $P(\\text{not }A)=1-P(A)$.",
  "items": [
    {
      "type": "worked-example",
      "id": 1,
      "prompt": "A table has $120$ people; $30$ are left-handed. Find $P(\\text{left-handed})$.",
      "solution": {
        "steps": [
          "Favorable count is $30$; total is $120$.",
          "$\\frac{30}{120}=\\frac{1}{4}$."
        ],
        "answer": "$\\dfrac{1}{4}$"
      }
    },
    {
      "type": "worked-example",
      "id": 2,
      "prompt": "Of $50$ students, $20$ are seniors and $8$ of those seniors drive. Find $P(\\text{drives}\\mid\\text{senior})$.",
      "solution": {
        "steps": [
          "Restrict to the $20$ seniors.",
          "Among them, $8$ drive: $\\frac{8}{20}=0.4$."
        ],
        "answer": "$0.4$"
      }
    },
    {
      "type": "worked-example",
      "id": 3,
      "prompt": "If $P(A)=0.3$, find $P(\\text{not }A)$.",
      "solution": {
        "steps": [
          "Use the complement rule: $1-0.3=0.7$."
        ],
        "answer": "$0.7$"
      }
    },
    {
      "type": "practice",
      "id": 4,
      "prompt": "$P$ of a red card from a 52-card deck.",
      "solution": {
        "steps": [
          "$\\frac{26}{52}=\\frac{1}{2}$."
        ],
        "answer": "$\\dfrac{1}{2}$"
      }
    },
    {
      "type": "practice",
      "id": 5,
      "prompt": "Of $40$ dogs, $10$ are puppies. $P(\\text{puppy})$.",
      "solution": {
        "steps": [
          "$\\frac{10}{40}=0.25$."
        ],
        "answer": "$0.25$"
      }
    },
    {
      "type": "practice",
      "id": 6,
      "prompt": "$P(\\text{not }A)$ if $P(A)=0.6$.",
      "solution": {
        "steps": [
          "$1-0.6=0.4$."
        ],
        "answer": "$0.4$"
      }
    }
  ]
