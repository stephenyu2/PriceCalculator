      "id": 2,
      "prompt": "Compare $\\frac{1}{4}$ and $\\frac{3}{4}$. Which is greater?",
      "solution": {
        "steps": [
          "Same denominator, so compare numerators: $3 > 1$.",
          "So $\\frac{3}{4} > \\frac{1}{4}$."
        ],
        "answer": "$\\frac{3}{4}$"
      }
    },
