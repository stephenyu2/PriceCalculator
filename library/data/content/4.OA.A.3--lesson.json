      "type": "worked-example",
      "id": 1,
      "prompt": "A class has $6$ tables with $4$ students each. If $5$ students leave, how many remain?",
      "solution": {
        "steps": [
          "First multiply: $6 \\times 4 = 24$ students.",
          "Then subtract: $24 - 5 = 19$."
        ],
        "answer": "$19$ students"
      }
    },
    {
      "type": "worked-example",
      "id": 2,
      "prompt": "You buy $3$ packs of $8$ pencils and give away $10$. How many are left?",
      "solution": {
        "steps": [
          "$3 \\times 8 = 24$, then $24 - 10 = 14$."
        ],
        "answer": "$14$ pencils"
      }
    },
    {
      "type": "worked-example",
      "id": 3,
      "prompt": "A store has $50$ apples. It sells $6$ bags of $5$ apples. How many are left?",
      "solution": {
        "steps": [
          "$6 \\times 5 = 30$ sold, then $50 - 30 = 20$."
        ],
        "answer": "$20$ apples"
      }
    },
    {
      "type": "practice",
      "id": 4,
      "prompt": "Tickets cost $\\$7$ each. You buy $4$ and pay with $\\$30$. How much change?",
      "solution": {
        "steps": [
          "$4 \\times 7 = 28$, then $30 - 28 = 2$."
        ],
        "answer": "$\\$2$"
      }
    },
    {
      "type": "practice",
      "id": 5,
      "prompt": "A library adds $4$ shelves of $9$ books to its $12$ books. How many books now?",
      "solution": {
        "steps": [
          "$4 \\times 9 = 36$, then $36 + 12 = 48$."
        ],
        "answer": "$48$ books"
      }
    },
    {
      "type": "practice",
      "id": 6,
      "prompt": "You have $100$ stickers. You share them among $4$ friends, then keep the leftover $20$. How many did each friend get?",
      "solution": {
        "steps": [
          "Give away $100 - 20 = 80$, then $80 \\div 4 = 20$."
        ],
        "answer": "$20$ stickers"
      }
    }
