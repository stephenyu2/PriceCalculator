    {
      "type": "multiple-choice",
      "id": 4,
      "difficulty": "Medium",
      "prompt": "$\\lim_{x\\to 16}\\dfrac{\\sqrt{x}-4}{x-16}=?$\nA) $\\dfrac{1}{8}$\nB) $\\dfrac{1}{4}$\nC) $8$\nD) $0$",
      "answer": "A) $\\dfrac{1}{8}$",
      "solution": {
        "steps": [
          "Write $x-16=(\\sqrt{x}-4)(\\sqrt{x}+4)$ and cancel: $\\frac{1}{\\sqrt{x}+4}$.",
          "Substitute $x=16$: $\\frac{1}{4+4}=\\frac{1}{8}$. Key is A.",
          "B) forgets to add the two roots.",
          "C) inverts the fraction.",
          "D) is not indeterminate-zero."
        ],
        "answer": "A) $\\dfrac{1}{8}$"
      }
    },
    {
      "type": "multiple-choice",
      "id": 5,
      "difficulty": "Medium",
      "prompt": "$\\lim_{x\\to 2}\\dfrac{\\frac{1}{x}-\\frac{1}{2}}{x-2}=?$\nA) $-\\dfrac{1}{4}$\nB) $\\dfrac{1}{4}$\nC) $-\\dfrac{1}{2}$\nD) $0$",
      "answer": "A) $-\\dfrac{1}{4}$",
      "solution": {
        "steps": [
          "Combine the top: $\\frac{2-x}{2x}$; divide by $x-2$ to get $\\frac{-1}{2x}$.",
          "Substitute $x=2$: $-\\frac{1}{4}$. Key is A.",
          "B) drops the sign.",
          "C) forgets the $x$ in $2x$.",
          "D) ignores the simplification."
        ],
        "answer": "A) $-\\dfrac{1}{4}$"
      }
    },
