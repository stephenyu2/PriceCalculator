    {
      "type": "multiple-choice",
      "id": 3,
      "difficulty": "Medium",
      "prompt": "$\\lim_{x\\to 0}\\dfrac{x^2-6x}{x}=?$\nA) $-6$\nB) $0$\nC) $6$\nD) Does not exist",
      "answer": "A) $-6$",
      "solution": {
        "steps": [
          "Factor $x$: $\\frac{x(x-6)}{x}=x-6$.",
          "Substitute $x=0$: $-6$. Key is A.",
          "B) $0$ wrongly keeps the removed factor.",
          "C) drops the sign.",
          "D) ignores that the hole has a limit."
        ],
        "answer": "A) $-6$"
      }
