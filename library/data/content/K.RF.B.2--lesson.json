  "intro": "Kindergartners listen to the sounds in words. Rhyming words end with the same sound (cat, hat). Words can be clapped into syllables (ba-by is two). We can hear the first sound in a word.",
  "items": [
    {
      "type": "worked-example",
      "id": 1,
      "prompt": "Which word rhymes with 'cat': dog or hat?",
      "solution": {
        "steps": [
          "Rhyming words end with the same sound.",
          "'Hat' ends in -at, like 'cat.'",
          "So 'hat' rhymes with 'cat.'"
        ],
        "answer": "Hat."
      }
    },
    {
      "type": "worked-example",
      "id": 2,
      "prompt": "What is the first sound in 'sun'?",
      "solution": {
        "steps": [
          "I say the word slowly: s-u-n.",
          "The first sound is /s/.",
          "So the first sound is /s/."
        ],
        "answer": "/s/ (the s sound)."
      }
    },
    {
      "type": "worked-example",
      "id": 3,
      "prompt": "How many syllables (claps) in 'rabbit'?",
      "solution": {
        "steps": [
          "I clap it: rab-bit.",
          "That is two claps.",
          "So 'rabbit' has two syllables."
        ],
        "answer": "Two."
      }
    },
    {
      "type": "practice",
      "id": 4,
      "prompt": "Which rhymes with 'pig': wig or dog?",
      "solution": {
        "steps": [
          "'Wig' ends in -ig like 'pig.'"
        ],
        "answer": "Wig."
      }
    },
    {
      "type": "practice",
      "id": 5,
      "prompt": "First sound in 'map'?",
      "solution": {
        "steps": [
          "m-a-p, first sound /m/."
        ],
        "answer": "/m/."
      }
    },
    {
      "type": "practice",
      "id": 6,
      "prompt": "Syllables in 'apple'?",
      "solution": {
        "steps": [
          "ap-ple, two claps."
        ],
        "answer": "Two."
