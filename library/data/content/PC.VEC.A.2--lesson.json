    {
      "type": "practice",
      "id": 7,
      "prompt": "Find the value of $k$ that makes $\\vec{u}=\\langle k,5\\rangle$ and $\\vec{v}=\\langle 2,-3\\rangle$ orthogonal.",
      "hint": "Orthogonal vectors have dot product $0$. Set $\\vec{u}\\cdot\\vec{v}=0$ and solve for $k$.",
      "solution": {
        "steps": [
          "Set the dot product to zero: $\\vec{u}\\cdot\\vec{v}=(k)(2)+(5)(-3)=0$.",
          "Simplify: $2k-15=0$.",
          "Solve: $2k=15$, so $k=\\dfrac{15}{2}$."
        ],
        "answer": "$k=\\dfrac{15}{2}$"
      }
